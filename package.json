{
  "name": "node-socket",
  "version": "1.0.0",
  "description": "Node.JS的自定义TCP协议，实现客户端与服务端数据传输。",
  "author": "Tensho Chen",
  "main": "index.js",
  "types": "./src/@types/index.d.ts",
  "scripts": {
    "client:example": "ts-node --files example/client.ts",
    "server:example": "ts-node --files example/server.ts",
    "client:socks5": "ts-node --files socks5/client.ts",
    "server:socks5": "ts-node --files socks5/server.ts",
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "reverse": "node reverse/tunnel.cjs"
  },
  "license": "ISC",
  "dependencies": {
    "log4js": "^6.9.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.16"
  }
}
